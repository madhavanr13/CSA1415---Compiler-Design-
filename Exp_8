#include<stdio.h>
#include<string.h>
#include<ctype.h>

char production[10][20];
char follow[20];
int n,m=0;

void findFollow(char c)
{
    int i,j;

    if(c=='S')
        follow[m++]='$';

    for(i=0;i<n;i++)
    {
        for(j=3;production[i][j]!='\0';j++)
        {
            if(production[i][j]==c)
            {
                if(production[i][j+1]!='\0')
                    follow[m++]=production[i][j+1];
            }
        }
    }
}

int main()
{
    int i;

    printf("Enter number of productions: ");
    scanf("%d",&n);

    for(i=0;i<n;i++)
        scanf("%s",production[i]);

    char ch;
    printf("Enter Non-terminal: ");
    scanf(" %c",&ch);

    findFollow(ch);

    printf("FOLLOW(%c) = { ",ch);

    for(i=0;i<m;i++)
        printf("%c ",follow[i]);

    printf("}");

    return 0;
}
