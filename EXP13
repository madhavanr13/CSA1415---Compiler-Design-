#include <stdio.h>
#include <string.h>

char input[100];
int pos = 0;

int E();
int Eprime();
int T();
int Tprime();
int F();

int E()
{
    return T() && Eprime();
}

int Eprime()
{
    if (input[pos] == '+')
    {
        pos++;
        return T() && Eprime();
    }

    return 1;
}

int T()
{
    return F() && Tprime();
}

int Tprime()
{
    if (input[pos] == '*')
    {
        pos++;
        return F() && Tprime();
    }

    return 1;
}

int F()
{
    if (input[pos] == 'i' && input[pos + 1] == 'd')
    {
        pos += 2;
        return 1;
    }

    if (input[pos] == '(')
    {
        pos++;

        if (E() && input[pos] == ')')
        {
            pos++;
            return 1;
        }

        return 0;
    }

    return 0;
}

int main()
{
    printf("Enter input string: ");
    scanf("%s", input);

    if (E() && input[pos] == '\0')
        printf("Valid String\n");
    else
        printf("Invalid String\n");

    return 0;
}
